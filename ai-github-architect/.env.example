# =============================================================================
# AI GitHub Repository Architect — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_ENV=development            # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_SECRET_KEY=change-me-in-production-to-a-random-256-bit-string

# --- LLM Provider ---
LLM_PROVIDER=gemini            # gemini | openai (future)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=8192

# --- GitHub ---
# Personal Access Token — needs at minimum: public_repo (read) scope
# For private repos: repo scope
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_MAX_FILE_SIZE_KB=500   # Skip files larger than this (kilobytes)
GITHUB_MAX_REPO_SIZE_MB=100   # Warn if repo exceeds this
GITHUB_MAX_FILES_PER_ANALYSIS=150  # Cap on files sent for analysis

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_github_architect
POSTGRES_USER=architect
POSTGRES_PASSWORD=architect_password_change_me
DATABASE_URL=postgresql+asyncpg://architect:architect_password_change_me@localhost:5432/ai_github_architect

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=                # Leave empty for no auth (local dev)
REDIS_URL=redis://localhost:6379/0
REDIS_GITHUB_CACHE_TTL=3600   # seconds — cache GitHub API responses
REDIS_LLM_CACHE_TTL=86400     # seconds — cache LLM outputs (24 h)

# --- MCP Servers ---
# Path to the GitHub MCP server module (used by MCP client)
GITHUB_MCP_SERVER_MODULE=app.mcp.github_server.server

# --- LangSmith Tracing (optional) ---
LANGCHAIN_TRACING_V2=false     # Set to true to enable LangSmith tracing
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=             # Your LangSmith API key
LANGCHAIN_PROJECT=ai-github-architect

# --- Analysis Limits ---
ANALYSIS_TIMEOUT_SECONDS=300   # Max time for a full analysis run
MAX_CONCURRENT_ANALYSES=5      # Max parallel analysis jobs
FILE_CHUNK_SIZE_TOKENS=3000    # Token chunk size for large files
MAX_TOKENS_PER_AGENT=30000     # Max context tokens per agent call
